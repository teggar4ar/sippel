includes:
    - vendor/larastan/larastan/extension.neon

parameters:

    paths:
        - app/

    # Level 9 is the highest level
    level: 5

    ignoreErrors:
        # Livewire computed properties are accessed via magic __get
        - '#Access to an undefined property App\\Livewire\\.*::\$\w+#'
        # Filament closures use generic Model type, but specific models are passed at runtime
        - '#Access to an undefined property Illuminate\\Database\\Eloquent\\Model::\$\w+#'
        # Filament record can be Model|int|string in certain contexts
        - '#Cannot (access property|call method) .* on Illuminate\\Database\\Eloquent\\Model\|int\|string#'
        # PHPDoc array types from parent classes
        - '#PHPDoc type array<.*> of property .* is not covariant with PHPDoc type list<string>#'
        # Filament/Livewire return type unused parts (overriding parent methods)
        - '#never returns .* so it can be removed from the return type#'
        # Match expressions with runtime enum values
        - '#Match expression does not handle remaining value: string#'
        # Spatie Permission trait methods (assignRole, syncRoles) - added via trait
        - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Model::(assignRole|syncRoles)#'
        # Computed properties accessed on Model (Livewire computed returning Model)
        - '#Access to an undefined property App\\Models\\.*::\$\w+#'
        # Nullsafe access on guaranteed non-null (framework conventions)
        - '#Using nullsafe property access .* on left side of \?\? is unnecessary#'
        # Livewire computed property return type
        - '#should return .* but returns Illuminate\\Database\\Eloquent\\Model\|null#'
        # Livewire validation methods (rules, messages) are called via Livewire magic
        - '#Method App\\Livewire\\.*::(rules|messages)\(\) is unused#'
